<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window colours match the design tokens so there is no flash before Compose draws. -->
    <style name="Theme.Patchbay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pb_background</item>
        <item name="android:statusBarColor">@color/pb_background</item>
        <item name="android:navigationBarColor">@color/pb_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="pb_background">#FFE3E5E8</color>
    <color name="pb_icon_bg">#FF181B1E</color>
    <color name="pb_icon_fg">#FFE7E9EB</color>
</resources>
